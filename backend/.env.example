PORT=3600
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=youngstunna_rider_portal
JWT_SECRET=change_this_demo_secret
INTEGRATION_API_KEY=demo-integration-key

# Authentication System
AUTH_MODE=external
AUTH_SERVICE_URL=http://localhost:3000

# Other system service URLs. Update these when other groups are ready.
ORDER_MANAGEMENT_SERVICE_URL=http://localhost:4000
NOTIFICATION_SERVICE_URL=http://localhost:4100
CUSTOMER_TRACKING_SERVICE_URL=http://localhost:4200
PERFORMANCE_MONITORING_SERVICE_URL=http://localhost:4300
ANALYTICS_SERVICE_URL=http://localhost:4400
RETURN_MANAGEMENT_SERVICE_URL=http://localhost:4500

# Optional: update these if other groups use different endpoint names.
ORDER_MANAGEMENT_ASSIGNMENTS_PATH=/api/orders/assigned
NOTIFICATION_CREATE_PATH=/api/notifications
CUSTOMER_TRACKING_UPDATE_PATH=/api/tracking/status
PERFORMANCE_RECORD_PATH=/api/performance/deliveries
ANALYTICS_EVENT_PATH=/api/analytics/delivery-events
RETURN_CREATE_PATH=/api/returns

# Default rider used by Order Management shipment adapter when no rider id is provided
DEFAULT_RIDER_ID=1
